            <refinement name="downsample_row_linewise&lt;WIDTH,T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Conv_Col_High_Low"/>
            <refinement name="convolution_1D_col&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Conv_Row_High"/>
            <refinement name="convolution_1D_row&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
