<?xml version="1.0" encoding="UTF-8"?>
<scenario>
    <flags>
        <sizesAreInBit/>
    </flags>
    <files>
        <algorithm url="/Wavelet_Filter/Algo/wavelet_heterogeneous_tuto.pi"/>
        <architecture url="/Wavelet_Filter/Archi/2arm_fpga.slam"/>
        <codegenDirectory url="/Wavelet_Filter/Code/generated_tuto"/>
    </files>
    <constraints excelUrl="">
        <constraintGroup>
            <operator name="KRIA260"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Image_Add"/>
            <refinement name="sum&lt;input1_t,input2_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Conv_Col_Low_High"/>
            <refinement name="convolution_1D_col&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Downsample_Col_High"/>
            <refinement name="downsample_col_pixelwise&lt;T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Image_Add_Low"/>
            <refinement name="sum&lt;input1_t,input2_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Downsample_Row_Low_Low"/>
            <refinement name="downsample_row_linewise&lt;WIDTH,T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Conv_Col_High_High"/>
            <refinement name="convolution_1D_col&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Upsample_Col_Low"/>
            <refinement name="upsample_col_pixelwise&lt;T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Upsample_Row_Low_Low"/>
            <refinement name="upsample_row_linewise&lt;WIDTH,T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Downsample_Col_Low"/>
            <refinement name="downsample_col_pixelwise&lt;T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Conv_Col_Low_Low"/>
            <refinement name="convolution_1D_col&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Conv_Row_High"/>
            <refinement name="convolution_1D_row&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Upsample_Col_High"/>
            <refinement name="upsample_col_pixelwise&lt;T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Image_Add_High"/>
            <refinement name="sum&lt;input1_t,input2_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Upsample_Row_High_Low"/>
            <refinement name="upsample_row_linewise&lt;WIDTH,T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Conv_Row_Low"/>
            <refinement name="convolution_1D_row&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Downsample_Row_Low_High"/>
            <refinement name="downsample_row_linewise&lt;WIDTH,T&gt;"/>
