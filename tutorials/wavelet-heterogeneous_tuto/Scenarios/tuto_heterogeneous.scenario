            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Downsample_Row_High_Low"/>
            <refinement name="downsample_row_linewise&lt;WIDTH,T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Upsample_Row_Low_High"/>
            <refinement name="upsample_row_linewise&lt;WIDTH,T&gt;"/>
            <task name="wavelet_heterogeneous_tuto/DWT_2D_fpga/Conv_Col_High_Low"/>
            <refinement name="convolution_1D_col&lt;WIDTH,HEIGHT,FILTER_SIZE,input_t,filter_t,output_t&gt;"/>
            <task name="wavelet_heterogeneous_tuto/IDWT_2D_fpga/Conv_Col_High_High"/>
